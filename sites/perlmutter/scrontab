# Monitor schedule for NERSC Perlmutter: 06:00 UTC on the 1st and 15th of each month.
# Install with: scrontab sites/perlmutter/scrontab
# That replaces your whole table, so merge first if "scrontab -l" lists other entries.
#
# This short job runs on a login node. It connects to a login node over ssh, so the tick gets
# a clean environment: no SLURM settings pass to the test job, and it isn't held to the
# cron QOS's small share of a node while it builds a fresh environment.
#SCRON --account=amsc007
#SCRON --qos=cron
#SCRON --constraint=cron
#SCRON --nodes=1
#SCRON --ntasks=1
#SCRON --time=00:30:00
#SCRON --job-name=hpc-grafana-tick
0 6 1,15 * * ssh -o BatchMode=yes perlmutter.nersc.gov '/opt/cray/pe/python/3.12.12/bin/python3 "$HOME/RADICAL/RCT-HPC-DASHBOARD/radical-hpc-test-suite/hpc_monitor.py" tick --site "$HOME/RADICAL/RCT-HPC-DASHBOARD/radical-hpc-test-suite/sites/perlmutter/site.toml"' >> "$HOME/.hpc-monitor-grafana-scron.out" 2>&1
