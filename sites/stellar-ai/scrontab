# Monitor schedule for Stellar AI: 06:00 on the 1st and 15th of each month.
# Install with: scrontab sites/stellar-ai/scrontab
# That replaces your whole table, so merge first if "scrontab -l" lists other entries.
#
# crontab is denied on this machine and compute nodes have no internet, so this short job
# connects back to the login node, using the short hostname, and runs the monitor there.
# The limit allows for building a fresh environment on the tick that starts a run.
#SCRON --account=csd
#SCRON --partition=cpu
#SCRON --qos=test
#SCRON --nodes=1
#SCRON --ntasks=1
#SCRON --time=00:30:00
#SCRON --job-name=hpc-grafana-tick
0 6 1,15 * * ssh -o BatchMode=yes stellarai-amd 'python3 "$HOME/TEST-RHAPSODY/radical-hpc-test-suite/hpc_monitor.py" tick --site "$HOME/TEST-RHAPSODY/radical-hpc-test-suite/sites/stellar-ai/site.toml"' >> "$HOME/.hpc-monitor-grafana-scron.out" 2>&1
